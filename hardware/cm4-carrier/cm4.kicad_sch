		(uuid "05d1d244-d599-4883-8187-aadac7c5dba6"))
	(text "Wired here: +5V, GND, GPIO2/3 (I2C1), GPIO_VREF and CM4_3.3V_Out (+3V3);" (at 20.00 19.00 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "de033735-4455-4761-ae66-9a6c66540aaf"))
